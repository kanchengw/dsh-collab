@@ -0,0 +1,41 @@
+name: Collab Windows no-TUN
+
+on:
+  push:
+    branches:
+      - codex/collab-no-npcap-v2.6.4
+    tags:
+      - v2.6.4-collab.*
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install pinned Rust toolchain
+        shell: pwsh
+        run: rustup toolchain install 1.95.0 --profile minimal --target x86_64-pc-windows-msvc
+      - name: Install protoc
+        uses: arduino/setup-protoc@v3
+        with:
+          version: "26.0"
+          repo-token: ${{ github.token }}
+      - uses: Swatinem/rust-cache@v2
+        with:
+          key: collab-windows-no-tun
+      - name: Build and verify no-TUN runtime
+        shell: cmd
+        run: |
+          for /f "usebackq tokens=*" %%i in (`"%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set VSINSTALL=%%i
+          call "%VSINSTALL%\Common7\Tools\VsDevCmd.bat" -arch=x64 || exit /b 1
+          pwsh -NoProfile -File collab\windows-no-tun\build.ps1 || exit /b 1
+          pwsh -NoProfile -File collab\windows-no-tun\verify.ps1 || exit /b 1
+      - uses: actions/upload-artifact@v4
+        with:
+          name: easytier-windows-x86_64-v2.6.4-collab.1
+          path: artifacts/easytier-windows-x86_64-v2.6.4-collab.1.zip
+          if-no-files-found: error
