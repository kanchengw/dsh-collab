{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlannerOutput",
  "type": "object",
  "required": ["role", "status", "summary", "plan_markdown"],
  "properties": {
    "role": { "const": "planner" },
    "status": { "enum": ["planned", "blocked"] },
    "plan_kind": { "enum": ["initial", "revision", "replacement"] },
    "supersedes_attempt": { "type": ["integer", "null"] },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "plan_change"],
        "properties": {
          "finding": { "type": "string" },
          "plan_change": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "plan_markdown": { "type": "string", "minLength": 1 },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goal", "acceptance", "dependencies"],
        "properties": {
          "id": { "type": "string" },
          "goal": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "parallelizable": { "type": "boolean" },
          "out_of_scope": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "unverified": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
